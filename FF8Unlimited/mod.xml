<?xml version="1.0" encoding="utf-8"?>
<ModInfo>
  <ID>6ed51118-e60c-4087-8626-e9e9b6acd886</ID>
  <Name>FF8 Unlimited</Name>
  <Author>BreDoyliesSea</Author>
  <Version>1.3</Version>
  <Description>Lifts FF8's list limits and lets you pick the Triple Triad rules. Each part is an option and can be switched off. All Magic: every character holds every spell at once (64 slots instead of 32), up to 100 each, and every magic screen pages through them. Unlimited GF Abilities: no 22-ability limit per GF; teach any number with items. Card rules: force each Triple Triad rule and the trade rule on or off in every region. Requires the Steam 2013 English FF8_EN.exe.</Description>
  <ReleaseNotes>1.3: released as a Junction VIII .iroj archive, so installing from the catalog works. 1.2: works alongside Cronos and FF8 Gameplay Customizer: load order and their Junction value rework option are checked by Junction VIII. 1.1: combines Triple Triad Rule Select, Unlimited GF Abilities and All Magic Per Character into one mod with options. Page numbers past 9 show two digits.</ReleaseNotes>
  <ReleaseDate>2026-10-07</ReleaseDate>
  <Category>Gameplay</Category>
  <Link>https://github.com/BreDoyliesSea/FF8Mods</Link>
  <DonationLink />
  <GameLanguage>EN</GameLanguage>

  <ConfigOption>
    <Name>All Magic Per Character</Name>
    <ID>AllMagic</ID>
    <Type>List</Type>
    <Default>1</Default>
    <Description>Every character can hold all spells, up to 100 each. The extra magic is stored in your save. Keep this on for saves made with it, or their magic will not load correctly.</Description>
    <Option Value="1" Name="On" />
    <Option Value="0" Name="Off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Unlimited GF Abilities</Name>
    <ID>GFAbilities</ID>
    <Type>List</Type>
    <Default>1</Default>
    <Description>No 22-ability limit per GF. GF ability lists get as many pages as they need.</Description>
    <Option Value="1" Name="On" />
    <Option Value="0" Name="Off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Open</Name>
    <ID>RuleOpen</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Both hands are visible to both players.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Same</Name>
    <ID>RuleSame</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Flip neighbours when two or more touching sides are equal.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Plus</Name>
    <ID>RulePlus</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Flip neighbours when two or more touching sides add up to the same sum.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Random</Name>
    <ID>RuleRandom</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Your five cards are picked at random from your collection.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Sudden Death</Name>
    <ID>RuleSuddenDeath</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>A draw restarts the match with the cards each player owns on the board.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Same Wall</Name>
    <ID>RuleSameWall</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>The board edges count as A for Same (only matters when Same is also on).</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Elemental</Name>
    <ID>RuleElemental</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Elemental squares raise or lower card ranks.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="Always on" />
    <Option Value="2" Name="Always off" />
  </ConfigOption>
  <ConfigOption>
    <Name>Card rule: Trade</Name>
    <ID>TradeRule</ID>
    <Type>List</Type>
    <Default>0</Default>
    <Description>Which cards change hands after a match.</Description>
    <Option Value="0" Name="Region default" />
    <Option Value="1" Name="One" />
    <Option Value="2" Name="Diff" />
    <Option Value="3" Name="Direct" />
    <Option Value="4" Name="All" />
    <Option Value="5" Name="None (no cards change hands)" />
  </ConfigOption>

  <OrderConstraints>
    <After>260dd8f3-537a-4d34-b3d5-956cda71eac9</After>
    <After>260dd8f3-537a-4d34-b3d5-956cda71eaca</After>
  </OrderConstraints>
  <Compatibility>
    <Setting>
      <MyID>AllMagic</MyID>
      <MyValue>1</MyValue>
      <ModID>260dd8f3-537a-4d34-b3d5-956cda71eac9</ModID>
      <TheirID>JunctionRework</TheirID>
      <Forbid>2</Forbid>
    </Setting>
    <Setting>
      <MyID>AllMagic</MyID>
      <MyValue>1</MyValue>
      <ModID>260dd8f3-537a-4d34-b3d5-956cda71eaca</ModID>
      <TheirID>JunctionRework</TheirID>
      <Forbid>2</Forbid>
    </Setting>
  </Compatibility>

  <ModFolder Folder="options\AllMagic">
    <ActiveWhen>
      <Option>AllMagic=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\GFAbilities">
    <ActiveWhen>
      <Option>GFAbilities=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\PageNumbers">
    <ActiveWhen>
      <Or>
        <Option>AllMagic=1</Option>
        <Option>GFAbilities=1</Option>
      </Or>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules">
    <ActiveWhen>
      <Or>
        <Not><Option>RuleOpen=0</Option></Not>
        <Not><Option>RuleSame=0</Option></Not>
        <Not><Option>RulePlus=0</Option></Not>
        <Not><Option>RuleRandom=0</Option></Not>
        <Not><Option>RuleSuddenDeath=0</Option></Not>
        <Not><Option>RuleSameWall=0</Option></Not>
        <Not><Option>RuleElemental=0</Option></Not>
        <Not><Option>TradeRule=0</Option></Not>
      </Or>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Open_On">
    <ActiveWhen>
      <Option>RuleOpen=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Open_Off">
    <ActiveWhen>
      <Option>RuleOpen=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Same_On">
    <ActiveWhen>
      <Option>RuleSame=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Same_Off">
    <ActiveWhen>
      <Option>RuleSame=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Plus_On">
    <ActiveWhen>
      <Option>RulePlus=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Plus_Off">
    <ActiveWhen>
      <Option>RulePlus=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Random_On">
    <ActiveWhen>
      <Option>RuleRandom=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Random_Off">
    <ActiveWhen>
      <Option>RuleRandom=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\SuddenDeath_On">
    <ActiveWhen>
      <Option>RuleSuddenDeath=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\SuddenDeath_Off">
    <ActiveWhen>
      <Option>RuleSuddenDeath=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\SameWall_On">
    <ActiveWhen>
      <Option>RuleSameWall=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\SameWall_Off">
    <ActiveWhen>
      <Option>RuleSameWall=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Elemental_On">
    <ActiveWhen>
      <Option>RuleElemental=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Elemental_Off">
    <ActiveWhen>
      <Option>RuleElemental=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Trade_One">
    <ActiveWhen>
      <Option>TradeRule=1</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Trade_Diff">
    <ActiveWhen>
      <Option>TradeRule=2</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Trade_Direct">
    <ActiveWhen>
      <Option>TradeRule=3</Option>
    </ActiveWhen>
  </ModFolder>
  <ModFolder Folder="options\CardRules\options\Trade_All">
    <ActiveWhen>
      <Option>TradeRule=4</Option>
    </ActiveWhen>
